# Copiez ce fichier en .env et ajustez les valeurs si necessaire.
# Aucune cle API de fournisseur cloud ne doit jamais figurer ici : l'application
# fonctionne entierement en local (Ollama + Qdrant + SQLite).

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Correctif 8 : parametres d'embedding par lots (POST /api/embed, keep_alive)
OLLAMA_EMBED_BATCH_SIZE=4
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_MAX_RETRIES=3
OLLAMA_KEEP_ALIVE=10m

# Qdrant : mode "embedded" (fichier local, sans Docker, recommande pour un poste notaire
# unique) ou "server" (necessite `docker compose up -d qdrant`, QDRANT_URL utilise alors).
QDRANT_MODE=embedded
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./output/qdrant_local

DATA_DIR=./data
OUTPUT_DIR=./output
SQLITE_PATH=./output/app_metadata.sqlite3

API_HOST=0.0.0.0
API_PORT=8000
